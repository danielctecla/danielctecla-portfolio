---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '@fontsource-variable/source-serif-4'

interface Props {
	title: string
}

const { title } = Astro.props
const description =
	'Daniel Catonga is a software engineer and artificial intelligence student based in Mexico City.'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={Astro.url.pathname} />
		<meta property="og:image" content="/assets/images/view.png" />
		<meta property="og:type" content="website" />
	</head>
	<body class="min-h-screen w-full bg-background-primary font-serif text-tx-primary antialiased">
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	::selection {
		background-color: #d6e2f7;
	}

	.prose-links a {
		@apply text-accent underline decoration-accent/25 underline-offset-[3px] transition-colors hover:text-accent-secondary hover:decoration-accent-secondary;
	}
</style>
