---
import Entry from './Entry.astro'

const AwardsItems = [
	{
		title: '1st place, Talent Land Hackathon',
		link: 'https://hackathon.genius-arena.com/',
		meta: 'Coppel Foundation challenge · team of 4',
		date: '2024'
	},
	{
		title: 'ICPC Gran Premio de México',
		link: 'https://icpc.global/ICPCID/9GCUW3KDZY8J',
		meta: 'Team “Una línea a la vez”',
		date: '2023'
	}
]
---

<ul class="space-y-5">
	{
		AwardsItems.map(({ title, link, meta, date }) => (
			<Entry title={title} href={link} meta={meta} date={date} />
		))
	}
</ul>
