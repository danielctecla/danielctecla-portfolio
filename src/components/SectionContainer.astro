---
interface Props {
	id?: string
	label?: string
	class?: string
}

const { id, label, class: className = '' } = Astro.props
---

<section id={id} class={`mx-auto max-w-2xl scroll-mt-8 ${className}`}>
	{
		label ? (
			<div class="grid gap-y-5 border-t border-background-secondary pt-8 sm:grid-cols-[7.5rem_1fr] sm:gap-x-6">
				<h2 class="font-mono text-xs uppercase tracking-widest text-tx-secondary sm:pt-1">{label}</h2>
				<div>
					<slot />
				</div>
			</div>
		) : (
			<slot />
		)
	}
</section>
