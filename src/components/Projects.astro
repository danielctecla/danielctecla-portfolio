---
import Entry from './Entry.astro'

const ProjectsItems = [
	{
		title: 'DevInterview',
		link: 'https://devinterview.vercel.app/',
		github: 'https://github.com/mvnueloc/DevInterview',
		date: '2024',
		description: 'A platform to practice technical interviews, built in a team of three.',
		stack: ['React', 'Tailwind']
	},
	{
		title: 'Binary classifier',
		link: 'https://github.com/danielctecla/binary-classifier',
		date: '2023',
		description: 'k-means++ and KNN implemented from scratch to split data points into two classes.',
		stack: ['C++']
	}
]
---

<ul class="space-y-6">
	{
		ProjectsItems.map(({ title, link, github, date, description, stack }) => (
			<Entry title={title} href={link} meta={stack.join(' · ')} date={date}>
				{description}
				{github && (
					<>
						{' '}
						<a href={github} target="_blank" rel="noopener">Source code</a>
					</>
				)}
			</Entry>
		))
	}
</ul>
